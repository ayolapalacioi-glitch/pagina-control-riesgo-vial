# ==============================================================================
# ARCHIVO DE CONFIGURACIÓN DE ENTORNO - SISTEMA DE SEGURIDAD VIAL INTELIGENTE
# ==============================================================================
# Copia este archivo como .env si deseas sobrescribir variables fuera de docker-compose:
# cp .env.example .env

# --- RED Y PUERTO DEL SERVIDOR ---
PORT=4000
FRONTEND_ORIGIN=*
LAN_IP=192.168.1.35

# --- MODELO DE INTELIGENCIA ARTIFICIAL (YOLO) ---
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONF=0.35
# Activa la detección automática de contornos rectangulares (cartelera/cebra de prueba)
BILLBOARD_MODE=true

# --- CONFIGURACIÓN DE CÁMARA WIFI / IP (VTA-84920) ---
# Habilitar transmisión continua RTSP en backend
RTSP_CAMERA_ENABLE=true

# Dirección IP local asignada a la cámara por el router Wi-Fi
RTSP_CAMERA_IP=192.168.1.76

# Credenciales ONVIF / RTSP locales configuradas en la cámara VTA
RTSP_CAMERA_USER=admin
RTSP_CAMERA_PASS=12345
RTSP_CAMERA_PORT=554
RTSP_CAMERA_PATH=/live/ch0

# URL de transmisión del proxy go2rtc (puente Docker de alto rendimiento)
RTSP_CAMERA_URL=rtsp://go2rtc:8554/vta_camera

# Salto de fotogramas para balancear CPU (2 = procesa 15 fps de 30 fps)
RTSP_FRAME_SKIP=2

# --- INTEGRACIÓN CLOUD TUYA / VTA SMART (OPCIONAL / FALLBACK) ---
# Utilizado para control motorizado PTZ (Motion Tracking) y stream en la nube
TUYA_CLIENT_ID=3a8cs4wmgppk54p9pkvv
TUYA_CLIENT_SECRET=8c7656d031a544a19461ec6eb9dc764b
TUYA_DEVICE_ID=eb66bb9aa668e53f31gxsh
TUYA_REGION=us

# --- BROKER MQTT (OPCIONAL) ---
USE_MQTT=false
MQTT_BROKER_URL=mqtt://mosquitto:1883
MQTT_TOPIC=yolo/crosswalk/cam-001
